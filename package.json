{
  "name": "dct-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "bun run --watch server/index.ts",
    "build": "bun run typecheck && bun run server/build.ts",
    "start": "bun server/dist/index.js",
    "typecheck": "tsc --noEmit && bun run typecheck:client",
    "test": "bun test ./server ./shared",
    "test:db:create": "bun run server/scripts/create-test-db.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bunx --bun drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "bun run server/db/migrate.ts",
    "db:seed": "bun run server/db/seed/index.ts",
    "db:reset": "bun run server/scripts/db-reset.ts && bun run db:migrate && bun run db:seed",
    "openapi:emit": "bun run server/scripts/openapi-emit.ts",
    "openapi:types": "bunx openapi-typescript docs/openapi.json -o shared/api-types.d.ts",
    "dev:client": "bun run --cwd client dev",
    "build:client": "bun run --cwd client build",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p client/tsconfig.node.json",
    "test:client": "bun run --cwd client test:e2e",
    "check:client": "bun run typecheck:client && biome check client && bun run build:client",
    "fonts:sync": "bun run --cwd client fonts:sync"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  }
}
