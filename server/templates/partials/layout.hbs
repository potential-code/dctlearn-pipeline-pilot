<!doctype html>
<html lang="{{#if ar}}ar{{else}}en{{/if}}" dir="{{#if ar}}rtl{{else}}ltr{{/if}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <style>
      body { margin: 0; padding: 0; background-color: #f5f5f7; font-family: Inter, "Noto Sans Arabic", -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
      .container { max-width: 560px; margin: 40px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; }
      .header { background-color: #3B2F92; padding: 24px 32px; }
      .header h1 { margin: 0; color: #ffffff; font-size: 20px; font-weight: 600; }
      .body { padding: 32px; }
      .body p { margin: 0 0 16px; color: #27272a; font-size: 15px; line-height: 1.6; }
      .cta { display: inline-block; margin: 8px 0 24px; padding: 12px 28px; background-color: #EE3E43; color: #ffffff !important; text-decoration: none; border-radius: 6px; font-size: 15px; font-weight: 600; }
      .muted { color: #71717a !important; font-size: 13px !important; word-break: break-all; }
      .footer { padding: 24px 32px; text-align: center; }
      .footer p { margin: 0; color: #a1a1aa; font-size: 12px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header"><h1>{{appName}}</h1></div>
      <div class="body">
        {{> @partial-block}}
      </div>
      <div class="footer"><p>&copy; {{year}} Department of Culture and Tourism – Abu Dhabi</p></div>
    </div>
  </body>
</html>
