{{!-- subject: You completed {{courseTitle}} --}}
{{#> layout title="Course completed"}}
{{#if ar}}
<p>مرحباً {{name}}،</p>
<p>تهانينا! لقد أكملت <strong>{{courseTitle}}</strong>.</p>
{{#if certificateUrl}}<a class="cta" href="{{certificateUrl}}">عرض الشهادة</a>
<p class="muted">الرقم التسلسلي: {{serial}}</p>{{/if}}
{{else}}
<p>Hi {{name}},</p>
<p>Congratulations — you completed <strong>{{courseTitle}}</strong>.</p>
{{#if certificateUrl}}<a class="cta" href="{{certificateUrl}}">View your certificate</a>
<p class="muted">Certificate serial: {{serial}}</p>{{/if}}
{{/if}}
{{/layout}}
