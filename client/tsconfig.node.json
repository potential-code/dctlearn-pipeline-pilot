{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["bun", "node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e", "tools"],
  "exclude": ["node_modules", "dist", "e2e/.out"]
}
