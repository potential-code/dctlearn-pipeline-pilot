# Copy to .env and fill in. Never commit .env. An empty value counts as unset. (API-CONTRACT §9.9)
PORT=8000
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dct_learn
# Tests use this database (bun run test:db:create)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dct_learn_test

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

MAIL_FROM=DCTLEARN@dctabudhabi.ae
# smtp (Mailpit, dev) | ses (deployed) | memory (tests)
MAIL_TRANSPORT=smtp
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
SES_REGION=me-central-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
FILE_SIGNING_SECRET=

REDIS_URL=redis://localhost:6379
JOBS_ENABLED=true

# Optional integrations: blank = off (Zoom 503 feature_off, AI rule-based / hidden)
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
ZOOM_WEBHOOK_SECRET=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL=
# Hosts AI embed scripts/iframes may load from (comma-separated)
AI_EMBED_ALLOWED_HOSTS=ai.potential.com
POTENTIAL_INTAKE_URL=
POTENTIAL_INTAKE_KEY=
VOICE_PROVIDER_KEY=
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
SENTRY_DSN=
EMPLOYEE_EMAIL_DOMAINS=dctabudhabi.ae

# Seed (dev only, refused in production). SEED.md password for every account.
SEED_PASSWORD=Dct!2026demo
